      {
        "accountId": "6000000000",
        "containerId": "100000000",
        "variableId": "121",
        "name": "CJS - Item IDs Array",
        "type": "jsm",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "javascript",
            "value": "function() {\n  var items = {{DLV - ecommerce.items}};\n  if (!items || !items.length) return [];\n  var ids = [];\n  for (var i = 0; i < items.length; i++) {\n    if (items[i] && items[i].item_id) {\n      ids.push(String(items[i].item_id));\n    }\n  }\n  return ids;\n}"
          }
        ]
      },
      {
        "accountId": "6000000000",
        "containerId": "100000000",
        "variableId": "122",
        "name": "CJS - First Item ID",
        "type": "jsm",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "javascript",
            "value": "function() {\n  var ids = {{CJS - Item IDs Array}};\n  return (ids && ids.length) ? ids[0] : '';\n}"
          }
        ]
      },
      {
        "accountId": "6000000000",
        "containerId": "100000000",
        "variableId": "123",
        "name": "CJS - Meta Contents Array",
        "type": "jsm",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "javascript",
            "value": "function() {\n  var items = {{DLV - ecommerce.items}};\n  if (!items || !items.length) return [];\n  var contents = [];\n  for (var i = 0; i < items.length; i++) {\n    if (items[i]) {\n      contents.push({\n        id: String(items[i].item_id || ''),\n        quantity: items[i].quantity || 1,\n        item_price: items[i].price || 0\n      });\n    }\n  }\n  return contents;\n}"
          }
        ]
      },
      {
        "accountId": "6000000000",
        "containerId": "100000000",
        "variableId": "124",
        "name": "CJS - Meta First Item Name",
        "type": "jsm",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "javascript",
            "value": "function() {\n  var items = {{DLV - ecommerce.items}};\n  return (items && items.length && items[0]) ? (items[0].item_name || '') : '';\n}"
          }
        ]
      }
