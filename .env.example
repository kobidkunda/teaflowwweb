# Optional: path to the local SQLite database.
DATABASE_PATH=./data/store.sqlite
# MCP server token (server-only). The /mcp endpoint authenticates ONLY via
# ?token=<MCP_TOKEN> query param compared constant-time against this value.
# Generate: openssl rand -hex 32. Never commit a real token; never ship to clients.
MCP_TOKEN=
# Admin root login (server-only). The first POST /api/admin/login bootstraps
# the root account from these values when admin_users is empty; afterwards the
# DB row is the source of truth — unset ADMIN_PASSWORD after first login.
# Usernames use lowercase letters, numbers, hyphens and underscores.
ADMIN_USERNAME=
# Preferred: scrypt hash from `node scripts/gen-admin-hash.mjs`. The plain
# password is never stored; the hash verifies with node:crypto scrypt.
ADMIN_PASSWORD_HASH=
# Boot-only fallback: used ONLY when ADMIN_PASSWORD_HASH is empty and no admin
# exists yet. Set ADMIN_PASSWORD_HASH and remove this after first login.
ADMIN_PASSWORD=
# Optional contact email stored on the bootstrapped root (password resets).
ADMIN_EMAIL=
# Session HMAC secret (server-only). Signs the admin_session cookie.
# Generate: openssl rand -hex 32. Rotating signs every session out.
SESSION_SECRET=
# Password-reset mailer (server-only). When SMTP_HOST is empty, reset links
# are kept in the database and the request is logged (see docs/OPERATIONS.md).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESET_FROM_EMAIL=
# Public base URL used to build reset links (e.g. https://shop.example.com).
APP_BASE_URL=
# Public storefront base URL for product feeds (Google Merchant Center, Meta Catalog).
# Defaults to canonical https://teafloww.com if unset. Must be a publicly reachable URL for Google crawlers.
FEED_BASE_URL=
# Structured log level: debug | info | warn | error (default info).
LOG_LEVEL=info
# SQLite backup directory for `npm run db:backup` (must be on persistent disk).
BACKUP_DIR=./data/backups
# Demo seed is fenced out of production: `npm run db:seed` refuses when
# NODE_ENV=production unless ALLOW_DEMO_SEED=1. Never set this on a live host.
ALLOW_DEMO_SEED=
# Verified-gateway webhook secret (server-only). Leave empty until a verified
# payment gateway is integrated — without it every webhook is rejected and no
# order can reach paid. Generate: openssl rand -hex 32.
PAYMENT_WEBHOOK_SECRET=
# Do not add live payment secrets until a verified payment gateway is integrated.

# --- International Commerce & Localization ---
# Set to 1 to enable local offline mock providers for Shiprocket, Razorpay, and translation
COMMERCE_MOCK_PROVIDERS=1
# Secret for HMAC signing of guest order tracking links (defaults to SESSION_SECRET if unset)
ORDER_ACCESS_SECRET=
# --- Payment Gateway (Razorpay) ---
# Active payment mode: test | production (defaults to test)
RAZORPAY_MODE=test
# Razorpay Test Mode Credentials (keys starting with rzp_test_)
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=
# Razorpay Production Mode Credentials (keys starting with rzp_live_)
RAZORPAY_PROD_KEY_ID=
RAZORPAY_PROD_KEY_SECRET=
RAZORPAY_PROD_WEBHOOK_SECRET=
# Legacy / Default fallback keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Shipping (Shiprocket) ---
# Active shipping mode: test | production (defaults to test)
SHIPROCKET_MODE=test
# Order creation trigger: manual (admin clicks dispatch in order view) | auto (prepared immediately when order is paid/COD)
SHIPROCKET_ORDER_CREATION_MODE=manual
# Shiprocket Test Mode Credentials
SHIPROCKET_TEST_EMAIL=
SHIPROCKET_TEST_PASSWORD=
# Shiprocket Production Mode Credentials
SHIPROCKET_PROD_EMAIL=
SHIPROCKET_PROD_PASSWORD=
# Legacy / Default fallback credentials
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# ExchangeRate-API key for live currency refresh
EXCHANGE_RATE_API_KEY=
# OpenAI API key and model for Translation Studio
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# International booking endpoint and bearer token
INTERNATIONAL_BOOKING_URL=
SHIPPING_BRIDGE_TOKEN=

# International commerce (server only). Leave unset until accounts are configured.
# Trusted reverse proxy must strip incoming country headers before stamping its own.
TRUST_COUNTRY_HEADER=
EXCHANGE_RATE_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ORDER_ACCESS_SECRET=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Account-specific normalized shipping adapter contracts; see docs/INTERNATIONAL_COMMERCE.md.
SHIPPING_COUNTRIES_URL=
INTERNATIONAL_RATE_URL=
INTERNATIONAL_BOOKING_URL=
LANDED_COST_URL=
SHIPPING_BRIDGE_TOKEN=
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=
TRANSLATION_DAILY_MAX_REQUESTS=100
COMMERCE_WORKER_SECRET=
COMMERCE_WORKER_URL=http://127.0.0.1:3000/api/internal/commerce
# Conservative total token reservations over a rolling 24 hours.
TRANSLATION_DAILY_MAX_TOKENS=500000
# Admin test bypass token for automated testing & rate-limit exemption (dev/test only).
ADMIN_TEST_TOKEN=
