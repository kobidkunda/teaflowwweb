{
  "name": "teafloww",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev -H 0.0.0.0 -p ${PORT:-3000}",
    "dev:restart": "./start.sh",
    "build": "rm -rf .next && NEXT_PRIVATE_BUILD_WORKER=0 next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:check": "node scripts/migrate.mjs --check",
    "db:backup": "node scripts/backup.mjs",
    "db:restore": "node scripts/restore.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:purge-mockup": "node scripts/purge-mockup-data.mjs",
    "db:purge-mockup:pg": "DATABASE_TYPE=postgres node scripts/purge-mockup-data.mjs",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "mcp": "node scripts/mcp-server.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "commerce:worker": "node --env-file=.env scripts/commerce-worker.mjs",
    "i18n:extract": "node scripts/localize-storefront-ui.mjs"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "better-sqlite3": "^12.2.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "^15.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "browserslist": [
    "chrome >= 110",
    "edge >= 110",
    "firefox >= 110",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "opera >= 96",
    "and_chr >= 110",
    "not dead"
  ]
}
